[worldserver]

########################################
# mod-temucraft-expeditions
########################################
#
#    Temucraft.Expeditions.Enable
#        Description: Expeditions on top of dungeons, entered through the Expedition Master (creature 608805).
#        Default:     1

Temucraft.Expeditions.Enable = 1

#
#    Temucraft.Expeditions.AllDungeons
#        Description: Every 5-player dungeon with an entrance and enough creature spots is an expedition. With 0 only the
#                     rows in mod_temucraft_expedition are.
#        Default:     1

Temucraft.Expeditions.AllDungeons = 1

#
#    Temucraft.Expeditions.Phase
#        Description: Phase mask the expedition party and its enemies use (the dungeon's own creatures are in phase 1).
#                     Must not be 1. mod-temucraft-companions uses the same value (Temucraft.Companions.ExpeditionPhase).
#        Default:     2

Temucraft.Expeditions.Phase = 2

#
#    Temucraft.Expeditions.MinLevel
#        Description: Lowest level for any expedition (an expedition row can ask for more).
#        Default:     10

Temucraft.Expeditions.MinLevel = 10

#
#    Temucraft.Expeditions.MaxPlayers
#    Temucraft.Expeditions.GroupRange
#        Description: Party size (1-5) and how close party members must stand to the leader to be taken along.
#        Default:     5, 40

Temucraft.Expeditions.MaxPlayers = 5
Temucraft.Expeditions.GroupRange = 40

#
#    Temucraft.Expeditions.UnlockAllTiers
#        Description: Offer every tier right away instead of one more per tier finished.
#        Default:     0

Temucraft.Expeditions.UnlockAllTiers = 0

#
#    Temucraft.Expeditions.Enemies
#    Temucraft.Expeditions.MinSpots
#    Temucraft.Expeditions.Variants
#        Description: Enemies per expedition (plus the boss), the fewest creature spots a dungeon needs to be an expedition, and how
#                     many daily story variants (different spots) an expedition has.
#        Default:     16, 8, 3

Temucraft.Expeditions.Enemies = 16
Temucraft.Expeditions.MinSpots = 8
Temucraft.Expeditions.Variants = 3

#
#    Temucraft.Expeditions.Health.Normal / Elite / Boss
#    Temucraft.Expeditions.Damage.Normal / Elite / Boss
#        Description: Enemy health and melee damage as multiples of a normal creature of the party's level (before the
#                     tier and party size). Spells are scaled by how much the level raised the creature.
#        Default:     1, 2.5, 8 and 1, 1.5, 2

Temucraft.Expeditions.Health.Normal = 1.0
Temucraft.Expeditions.Health.Elite = 2.5
Temucraft.Expeditions.Health.Boss = 8.0
Temucraft.Expeditions.Damage.Normal = 1.0
Temucraft.Expeditions.Damage.Elite = 1.5
Temucraft.Expeditions.Damage.Boss = 2.0

#
#    Temucraft.Expeditions.PerExtraPlayer.Health
#    Temucraft.Expeditions.PerExtraPlayer.Damage
#        Description: Added per player beyond the first (0.5 = +50% health each).
#        Default:     0.5, 0.1

Temucraft.Expeditions.PerExtraPlayer.Health = 0.5
Temucraft.Expeditions.PerExtraPlayer.Damage = 0.1

#
#    Temucraft.Expeditions.DeathPenalty
#        Description: Percent of the cache lost per death.
#        Default:     20

Temucraft.Expeditions.DeathPenalty = 20

#
#    Temucraft.Expeditions.Affix.FromTier
#    Temucraft.Expeditions.Affix.SecondFromTier
#        Description: Tier from which this week's first affix applies, and from which the second one also does.
#        Default:     4, 8

Temucraft.Expeditions.Affix.FromTier = 4
Temucraft.Expeditions.Affix.SecondFromTier = 8

#
#    Temucraft.Expeditions.Rich.PerDay
#        Description: How many expeditions are rich each day (the same for everyone). The first rich cache a
#                     character opens each day also gives the rich reward.
#        Default:     3

Temucraft.Expeditions.Rich.PerDay = 3

#
#    Temucraft.Expeditions.Rich.Keys
#        Description: The rich reward needs an Expedition Key. Keys are made from Cache Key Fragments, which
#                     every cache gives (ShardsPerTier x the tier); every ShardsPerKey shards make a key. Shards and
#                     keys are kept per character (no item, see .temucraft expedition status). 0 = no key needed.
#        Default:     1, 100, 10

Temucraft.Expeditions.Rich.Keys = 1
Temucraft.Expeditions.Rich.ShardsPerKey = 100
Temucraft.Expeditions.Rich.ShardsPerTier = 10

#
#    Temucraft.Expeditions.Rich.KeyItem
#        Description: Use a real item as the key instead (used up when opening). 0 = use the shard keys above.
#        Default:     0

Temucraft.Expeditions.Rich.KeyItem = 0

#
#    Temucraft.Expeditions.Rich.GoldMultiplier
#    Temucraft.Expeditions.Rich.Item
#    Temucraft.Expeditions.Rich.ItemCount
#        Description: Rich reward: the tier's gold times this, plus an item (0 = none).
#        Default:     1.0, 0, 1

Temucraft.Expeditions.Rich.GoldMultiplier = 1.0
Temucraft.Expeditions.Rich.Item = 0
Temucraft.Expeditions.Rich.ItemCount = 1

########################################
# Seasonal currency and the Wayfinder's Ledger
########################################
#
#    Temucraft.Expeditions.Season
#        Description: The current season. The Wayfinder's Ledger keeps points per season; raise this number to start
#                     a new one (relics and coins stay).
#        Default:     1

Temucraft.Expeditions.Season = 1

#
#    Temucraft.Expeditions.Currency.Item
#    Temucraft.Expeditions.Currency.PerTier
#        Description: The seasonal currency item (Wayfinder Coin) and how many each cache gives per tier (lowered by
#                     deaths like the gold). 0 = no coins.
#        Default:     608910, 5

Temucraft.Expeditions.Currency.Item = 608910
Temucraft.Expeditions.Currency.PerTier = 5

#
#    Temucraft.Expeditions.Ledger.Enable
#    Temucraft.Expeditions.Ledger.PointsPerTier
#        Description: The Wayfinder's Ledger (ranks and rewards in mod_temucraft_expedition_ledger_rank) and the points
#                     a cache gives per tier.
#        Default:     1, 10

Temucraft.Expeditions.Ledger.Enable = 1
Temucraft.Expeditions.Ledger.PointsPerTier = 10

#
#    Temucraft.Expeditions.Vendor.Enable
#        Description: The Wayfinder Quartermaster (creature 608901, place it with .npc add 608901) sells the wares in
#                     mod_temucraft_expedition_vendor for Wayfinder Coins.
#        Default:     1

Temucraft.Expeditions.Vendor.Enable = 1

########################################
# Nemesis
########################################
#
#    Temucraft.Expeditions.Nemesis.Enable
#    Temucraft.Expeditions.Nemesis.Entry
#    Temucraft.Expeditions.Nemesis.DisplayId
#        Description: The season's nemesis: its creature (any creature works; 608900 is Vorrath the Hollow Stalker with
#                     its own fight script) and a look to put on it (0 = the creature's own).
#        Default:     1, 608900, 0

Temucraft.Expeditions.Nemesis.Enable = 1
Temucraft.Expeditions.Nemesis.Entry = 608900
Temucraft.Expeditions.Nemesis.DisplayId = 0

#
#    Temucraft.Expeditions.Nemesis.AmbushFromTier
#    Temucraft.Expeditions.Nemesis.AmbushChance
#    Temucraft.Expeditions.Nemesis.AmbushAtPercent
#        Description: From this tier, each run has this percent chance that the nemesis ambushes the party once this
#                     percent of the enemies are down. Killing it is optional.
#        Default:     6, 15, 50

Temucraft.Expeditions.Nemesis.AmbushFromTier = 6
Temucraft.Expeditions.Nemesis.AmbushChance = 15
Temucraft.Expeditions.Nemesis.AmbushAtPercent = 50

#
#    Temucraft.Expeditions.Nemesis.Health
#    Temucraft.Expeditions.Nemesis.Damage
#        Description: The nemesis's health and damage compared to the run's expedition boss.
#        Default:     1.5, 1.2

Temucraft.Expeditions.Nemesis.Health = 1.5
Temucraft.Expeditions.Nemesis.Damage = 1.2

#
#    Temucraft.Expeditions.Nemesis.Spells
#    Temucraft.Expeditions.Nemesis.EnrageSpell
#    Temucraft.Expeditions.Nemesis.EnrageAt
#        Description: Spells the nemesis (608900's script) casts, as "spell:seconds" separated by spaces, and an enrage
#                     spell cast once below EnrageAt percent health (0 = none). Their damage is scaled like the other
#                     enemies' spells. Defaults: Cleave, Shadow Bolt Volley, Psychic Scream; Enrage.
#        Default:     "15496:8 17228:12 22884:30", 8599, 30

Temucraft.Expeditions.Nemesis.Spells = "15496:8 17228:12 22884:30"
Temucraft.Expeditions.Nemesis.EnrageSpell = 8599
Temucraft.Expeditions.Nemesis.EnrageAt = 30

#
#    Temucraft.Expeditions.Nemesis.LureItem
#    Temucraft.Expeditions.Nemesis.LureDropChance
#        Description: The Hollow Lure item (use it in a run to call the nemesis, once per run) and the percent chance a
#                     cache gives one.
#        Default:     608911, 10

Temucraft.Expeditions.Nemesis.LureItem = 608911
Temucraft.Expeditions.Nemesis.LureDropChance = 10

#
#    Temucraft.Expeditions.Nemesis.Coins
#    Temucraft.Expeditions.Nemesis.RewardItem
#    Temucraft.Expeditions.Nemesis.RewardCount
#    Temucraft.Expeditions.Nemesis.LedgerPoints
#        Description: What each party member gets when the nemesis falls in an ordinary run (ambush or lure).
#        Default:     50, 0, 1, 50

Temucraft.Expeditions.Nemesis.Coins = 50
Temucraft.Expeditions.Nemesis.RewardItem = 0
Temucraft.Expeditions.Nemesis.RewardCount = 1
Temucraft.Expeditions.Nemesis.LedgerPoints = 50

#
#    Temucraft.Expeditions.Nemesis.LairMap
#    Temucraft.Expeditions.Nemesis.LairUnlockTier
#        Description: The dungeon map of the nemesis lair (it must be an expedition; 33 = Shadowfang Keep). Its hidden
#                     tier ? opens once a character finished this tier in any expedition, tier ?? once ? is done.
#                     The two tiers are in mod_temucraft_expedition_nemesis_tier.
#        Default:     33, 8

Temucraft.Expeditions.Nemesis.LairMap = 33
Temucraft.Expeditions.Nemesis.LairUnlockTier = 8

########################################
# Relics
########################################
#
#    Temucraft.Expeditions.Relics.Enable
#    Temucraft.Expeditions.Relics.DropChance
#        Description: Relics (mod_temucraft_expedition_relic): one combat and one utility relic per character, ranks
#                     1 to 4, working only inside expeditions. A cache has this percent chance to give a relic the
#                     character does not have yet.
#        Default:     1, 10

Temucraft.Expeditions.Relics.Enable = 1
Temucraft.Expeditions.Relics.DropChance = 10

#
#    Temucraft.Expeditions.Relics.ShieldRenewSeconds
#    Temucraft.Expeditions.Relics.MaxDamageTakenReduction
#        Description: How long a broken relic or power shield takes to come back, and the most damage taken can be
#                     lowered by relics and powers together (percent).
#        Default:     20, 50

Temucraft.Expeditions.Relics.ShieldRenewSeconds = 20
Temucraft.Expeditions.Relics.MaxDamageTakenReduction = 50

#
#    Temucraft.Expeditions.Relics.CompanionEntries
#    Temucraft.Expeditions.Relics.CompanionRange
#        Description: Creature entries of companions (mod-temucraft-followers), separated by spaces, and how far away a
#                     companion still gets the relic and power auras meant for it.
#        Default:     "608810 608811 608812", 100

Temucraft.Expeditions.Relics.CompanionEntries = "608810 608811 608812"
Temucraft.Expeditions.Relics.CompanionRange = 100

########################################
# Expedition powers
########################################
#
#    Temucraft.Expeditions.Powers.Enable
#    Temucraft.Expeditions.Powers.Disturbances
#    Temucraft.Expeditions.Powers.Chests
#    Temucraft.Expeditions.Powers.Choices
#    Temucraft.Expeditions.Powers.ChestCoins
#        Description: Expedition powers (mod_temucraft_expedition_power): run buffs that stack and end when you leave.
#                     Each run has this many Strange Disturbances (choose one of Choices powers) and chests (a random
#                     power and ChestCoins Wayfinder Coins), next to enemy spots. Each player can use each one once.
#        Default:     1, 2, 2, 3, 3

Temucraft.Expeditions.Powers.Enable = 1
Temucraft.Expeditions.Powers.Disturbances = 2
Temucraft.Expeditions.Powers.Chests = 2
Temucraft.Expeditions.Powers.Choices = 3
Temucraft.Expeditions.Powers.ChestCoins = 3

########################################
# Bounty maps and Hidden Troves
########################################
#
#    Temucraft.Expeditions.Bounty.Enable
#    Temucraft.Expeditions.Bounty.Item
#    Temucraft.Expeditions.Bounty.DropChance
#        Description: The Wayfinder's Bounty Map: use it inside a run (one a week per character) and a Hidden Trove
#                     appears next to the cache for you. A cache has this percent chance to give one if you have none.
#        Default:     1, 608912, 25

Temucraft.Expeditions.Bounty.Enable = 1
Temucraft.Expeditions.Bounty.Item = 608912
Temucraft.Expeditions.Bounty.DropChance = 25

#
#    Temucraft.Expeditions.Bounty.Trove.Coins
#    Temucraft.Expeditions.Bounty.Trove.Gold
#    Temucraft.Expeditions.Bounty.Trove.Item
#    Temucraft.Expeditions.Bounty.Trove.ItemCount
#    Temucraft.Expeditions.Bounty.Trove.RelicChance
#        Description: What a Hidden Trove holds: Wayfinder Coins, gold (copper), an item (0 = none) and a percent chance
#                     of a relic the character does not have yet.
#        Default:     40, 500000, 0, 1, 25

Temucraft.Expeditions.Bounty.Trove.Coins = 40
Temucraft.Expeditions.Bounty.Trove.Gold = 500000
Temucraft.Expeditions.Bounty.Trove.Item = 0
Temucraft.Expeditions.Bounty.Trove.ItemCount = 1
Temucraft.Expeditions.Bounty.Trove.RelicChance = 25

#
#    Temucraft.Expeditions.Gravestone.Enable
#        Description: Gravestones: a player who dies in a run leaves a gravestone where they fell; a party member can use it to raise them there.
#        Default:     1

Temucraft.Expeditions.Gravestone.Enable = 1

#
#    Temucraft.Expeditions.Gravestone.Entry
#        Description: Game object of the gravestone (also its npc_text). Must match data/sql.
#        Default:     608905

Temucraft.Expeditions.Gravestone.Entry = 608905

#
#    Temucraft.Expeditions.Gravestone.UsesPerRun
#        Description: How many times each player can be raised by a gravestone in one run (0 = no gravestones).
#        Default:     1

Temucraft.Expeditions.Gravestone.UsesPerRun = 1

#
#    Temucraft.Expeditions.Gravestone.FromTier
#        Description: Lowest tier with gravestones.
#        Default:     1

Temucraft.Expeditions.Gravestone.FromTier = 1

#
#    Temucraft.Expeditions.Gravestone.ToTier
#        Description: Highest tier with gravestones (0 = every tier from FromTier).
#        Default:     0

Temucraft.Expeditions.Gravestone.ToTier = 0

#
#    Temucraft.Expeditions.Gravestone.InLair
#        Description: Gravestones in the nemesis lair's hidden tiers too.
#        Default:     1

Temucraft.Expeditions.Gravestone.InLair = 1

#
#    Temucraft.Expeditions.Gravestone.Seconds
#        Description: Seconds a gravestone stays (a new death moves it).
#        Default:     600

Temucraft.Expeditions.Gravestone.Seconds = 600

#
#    Temucraft.Expeditions.Gravestone.RestorePercent
#        Description: Health and mana a player raised at a gravestone comes back with, in percent.
#        Default:     50

Temucraft.Expeditions.Gravestone.RestorePercent = 50

#
#    Temucraft.Expeditions.Slayer.Enable
#        Description: Slayer enemies: a chance per run that one normal enemy is a tougher slayer that carries extra Wayfinder Coins (its name in messages comes from module_string 101, "Slayer {}").
#        Default:     1

Temucraft.Expeditions.Slayer.Enable = 1

#
#    Temucraft.Expeditions.Slayer.FromTier
#        Description: Lowest tier that can have a slayer (never in the nemesis lair).
#        Default:     3

Temucraft.Expeditions.Slayer.FromTier = 3

#
#    Temucraft.Expeditions.Slayer.Chance
#        Description: Percent chance per run of a slayer.
#        Default:     25

Temucraft.Expeditions.Slayer.Chance = 25

#
#    Temucraft.Expeditions.Slayer.Health
#        Description: Slayer health, times that of a normal enemy of the run.
#        Default:     3.0

Temucraft.Expeditions.Slayer.Health = 3.0

#
#    Temucraft.Expeditions.Slayer.Damage
#        Description: Slayer damage (melee and spells), times that of a normal enemy of the run.
#        Default:     1.5

Temucraft.Expeditions.Slayer.Damage = 1.5

#
#    Temucraft.Expeditions.Slayer.Scale
#        Description: Slayer size, times its normal size.
#        Default:     1.25

Temucraft.Expeditions.Slayer.Scale = 1.25

#
#    Temucraft.Expeditions.Slayer.Coins
#        Description: Extra Wayfinder Coins for every party member when the slayer falls (relic and power coin bonuses apply).
#        Default:     10

Temucraft.Expeditions.Slayer.Coins = 10

#
#    Temucraft.Expeditions.Slayer.LedgerPoints
#        Description: Wayfinder's Ledger points for every party member when the slayer falls.
#        Default:     0

Temucraft.Expeditions.Slayer.LedgerPoints = 0

#
#    Temucraft.Expeditions.Addon.Enable
#        Description: Send the TemucraftExpeditions window its data (addon messages, prefix TEX): the run, powers, relics and the ledger.
#        Default:     1

Temucraft.Expeditions.Addon.Enable = 1
